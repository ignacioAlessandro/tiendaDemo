generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrdenEstado {
  CART
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model Categoria {
  id            String         @id @default(uuid())
  nombre        String         @unique
  productos     Producto[]
  subcategorias Subcategoria[]
}

model Subcategoria {
  id           String     @id @default(uuid())
  nombre       String
  categoriaId  String
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  productos    Producto[]

  @@unique([nombre, categoriaId])
}

model Producto {
  id             String        @id @default(uuid())
  nombre         String
  slug           String        @unique
  descripcion    String?
  precio_cents   Int
  stock          Int
  imagen_url     String?
  creadoAt       DateTime      @default(now())

  categoriaId    String
  subcategoriaId String

  categoria      Categoria    @relation(fields: [categoriaId], references: [id])
  subcategoria   Subcategoria @relation(fields: [subcategoriaId], references: [id])

  ordenItems     OrdenItem[]
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  apellido     String?
  email        String   @unique
  passwordHash String
  documento    String?
  telefono     String?
  creadoAt     DateTime @default(now())
  actualizadoAt DateTime @default(now()) @updatedAt

  ordenes      Orden[]
}

model Orden {
  id            String       @id @default(uuid())
  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])

  estado        OrdenEstado  @default(CART)
  total         Int          @default(0)   // en centavos

  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  items         OrdenItem[]
}

model OrdenItem {
  id             String    @id @default(uuid())
  ordenId        String
  productoId     String
  cantidad       Int       @default(1)
  precioUnitario Int       // en centavos, congelado al momento de agregar

  orden          Orden     @relation(fields: [ordenId], references: [id])
  producto       Producto  @relation(fields: [productoId], references: [id])
}
