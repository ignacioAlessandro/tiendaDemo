generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Producto {
  id             String        @id @default(uuid())
  nombre         String
  slug           String        @unique
  descripcion    String?
  precio_cents   Int
  stock          Int
  imagen_url     String?
  creadoAt       DateTime      @default(now())
  categoriaId    String?
  subcategoriaId String?
  ordenItems     OrdenItem[]
  subcategoria   Subcategoria? @relation(fields: [subcategoriaId], references: [id])
  categoria      Categoria?    @relation(fields: [categoriaId], references: [id])
}

model Categoria {
  id            String         @id @default(uuid())
  nombre        String         @unique
  productos     Producto[]
  subcategorias Subcategoria[]
}

model Subcategoria {
  id          String     @id @default(uuid())
  nombre      String
  categoriaId String
  productos   Producto[]
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])

  @@unique([nombre, categoriaId])
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String?
  documento    String?
  telefono     String?
  creadoAt     DateTime @default(now())
  ordenes      Orden[]
}

model Orden {
  id               String      @id @default(uuid())
  usuarioId        String?
  emailInvitado    String?
  total_cents      Int
  estado           String      @default("pendiente")
  mp_preference_id String?
  mp_payment_id    String?
  creadoAt         DateTime    @default(now())
  usuario          Usuario?    @relation(fields: [usuarioId], references: [id])
  items            OrdenItem[]
}

model OrdenItem {
  id                String   @id @default(uuid())
  ordenId           String
  productoId        String
  cantidad          Int
  precio_unit_cents Int
  producto          Producto @relation(fields: [productoId], references: [id])
  orden             Orden    @relation(fields: [ordenId], references: [id])
}
