datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Producto {
  id           String      @id @default(uuid())
  nombre       String
  slug         String      @unique
  descripcion  String?
  precio_cents Int
  stock        Int
  imagen_url   String?
  creadoAt     DateTime    @default(now())
  categoriaId    String?
  categoria      Categoria?  @relation(fields: [categoriaId], references: [id])
  subcategoriaId String?
  subcategoria   Subcategoria? @relation(fields: [subcategoriaId], references: [id])
  ordenItems   OrdenItem[]
}

model Categoria {
  id           String       @id @default(uuid())
  nombre       String       @unique
  subcategorias Subcategoria[]
  productos    Producto[]
}

model Subcategoria {
  id          String    @id @default(uuid())
  nombre      String
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  productos   Producto[]
  @@unique([nombre, categoriaId])
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String?
  documento    String?
  telefono     String?
  creadoAt     DateTime @default(now())
  ordenes      Orden[]
}

model Orden {
  id               String      @id @default(uuid())
  usuarioId        String?
  usuario          Usuario?    @relation(fields: [usuarioId], references: [id])
  emailInvitado    String?
  total_cents      Int
  estado           String      @default("pendiente")
  mp_preference_id String?
  mp_payment_id    String?
  creadoAt         DateTime    @default(now())
  items            OrdenItem[]
}

model OrdenItem {
  id                String   @id @default(uuid())
  ordenId           String
  orden             Orden    @relation(fields: [ordenId], references: [id])
  productoId        String
  producto          Producto @relation(fields: [productoId], references: [id])
  cantidad          Int
  precio_unit_cents Int
}
